# Nextflow specific files and directories
.nextflow/
work/
.nextflow*
results/ # Or whatever directory you use for final output
trace.txt
report.html
timeline.html
.nextflow_schema.json

# .nextflow.log is a per-run artifact containing absolute paths from whoever ran
# it last. Tracking it makes `git pull` abort with "Your local changes to the
# following files would be overwritten by merge" for every user who has run the
# pipeline. The `!.nextflow.log` negation that used to live here is removed.
.nextflow.log
.nextflow.log.*

# Nextflow writes here when a publishDir path resolves to a null param
null/
# Common development files
.DS_Store
.vscode/
.idea/
*.swp
*.bak
*.orig
# Assembly databases
cdc_fasta/
contextual_fasta/
# Downsampling outputs (generated artifacts)
downsample_out/
# Pipeline result directories (large outputs)
# Any pipeline output directory. These are large and are regenerated by a run.
results_*/
# Reference genome staged via Drive (not committed)
reference/
# Python bytecode
__pycache__/
# Ad-hoc run logs
resume_*.log
run_*.log
downsample_out_sweep.log
# Ad-hoc diagnostic artifacts recovered from work/
diagnostics_*/
