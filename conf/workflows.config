/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    wf-assembly-snps Nextflow workflows config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// This code is adapted from: https://github.com/bactopia/bactopia
//
// Nothing reads these values any more. They drove the nested if/each block in
// nextflow.config that assembled the module include list at parse time; that
// block is now a static list of the five files it always resolved to, because
// Nextflow 26.x's strict config parser rejects control flow in a config file.
// The map is kept because it is where the module list is written down, and the
// static includes are checked against it.
//
// Two syntax changes were needed for 26.x, neither of which alters the parsed
// result: scope names are unquoted, and the 'parsnp' entry's `description` is a
// comment rather than `description:`. That colon made it a Groovy label, not an
// assignment, so `description` was never a key in the first place -- it does not
// appear in `nextflow config` output on any version.

params {
    available_workflows {
        snp_package = ['parsnp']
    }
    workflows {
        // Workflows (main SNP workflow)
        // parsnp: identify SNPs from genome assemblies.
        parsnp {
            includes    = ['parsnp']
            is_workflow = true
            modules     = ["convert_samplesheet_python", "infile_handling_unix", "core_genome_alignment_parsnp",
                            "convert_gingr_to_fasta_harvesttools", "build_phylogenetic_tree_parsnp"]
        }

        // Subworkflows

        // Modules (contains params.config)
        // local
        convert_samplesheet_python {
            path        = "modules/local/convert_samplesheet_python"
        }
        infile_handling_unix {
            path        = "modules/local/infile_handling_unix"
        }
        core_genome_alignment_parsnp {
            path        = "modules/local/core_genome_alignment_parsnp"
        }
        convert_gingr_to_fasta_harvesttools {
            path        = "modules/local/convert_gingr_to_fasta_harvesttools"
        }
        build_phylogenetic_tree_parsnp {
            path        = "modules/local/build_phylogenetic_tree_parsnp"
        }

        // nf-core/modules
    }
}
