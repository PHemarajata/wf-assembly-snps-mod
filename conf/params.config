/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    wf-assembly-snps Nextflow params config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// This code is adapted from: https://github.com/bactopia/bactopia

params {
    /*
    ============================================
        Input Options
    ============================================
    */

    input                             = null
    ref                               = null
    outdir                            = null

    /*
    ============================================
        SNP workflow (parsnp)
    ============================================
    */

    snp_package                       = "parsnp"

    /*
    ============================================
        Default parameters
    ============================================
    */

    // Minimum input filesize required
    min_input_filesize                = "45k"

    // Default parameters
    recombination                     = "none"

    // Excel spreadsheet parameters
    excel_sheet_name                  = "Sheet1"
    create_excel_outputs              = false

    /*
    ============================================
        Parsnp-specific parameters
    ============================================
    */
    
    // Parsnp parameters
    curated_input                     = false    // Use curated input mode
    tree_method                       = "fasttree"  // Tree method: "fasttree" or "raxml"
    max_partition_size                = 15000    // Maximum partition size for Parsnp
    
    // File size validation parameters
    min_parsnp_output_filesize        = "1k"     // Minimum Parsnp output file size
    min_gingr_to_fasta_filesize       = "1k"     // Minimum Gingr to FASTA file size
    min_tree_filesize                 = "100"    // Minimum tree file size

    /*
    ============================================
        Scalable workflow parameters
    ============================================
    */

    // Enable scalable mode (clustering-based approach)
    scalable_mode                     = false
    
    // Workflow mode: 'cluster', 'place', or 'global'
    workflow_mode                     = "cluster"
    
    // Resume optimization parameters
    enable_resume_optimization        = true    // Enable checksum-based resume optimization
    work_cache_dir                    = "${params.outdir}/work_cache"  // Directory for cached work files
    
    // Clustering parameters
    mash_threshold                    = 0.03
    max_cluster_size                  = 100
    merge_singletons                  = false  // Merge all singleton clusters into one large cluster

    // Curated mode (optional): supply a pre-computed partition and per-cluster
    // references to BYPASS Mash clustering + medoid selection entirely. Both must
    // be set to activate. Use when Mash single-linkage cannot partition the
    // collection (measured: 2802 B. pseudomallei collapse to one component at
    // threshold >= 0.007) -- supply a PopPUNK/fastbaps partition and the complete
    // or borrowed reference each cluster uses.
    //   cluster_assignments : TSV, header `cluster_id<TAB>sample_id`, one row/genome
    //   cluster_references  : TSV, header `cluster_id<TAB>reference_path`, one row/cluster
    cluster_assignments               = null
    cluster_references                = null

    // Replicon splitting: when true, split each cluster's (complete) reference
    // into one FASTA per replicon and run alignment + Gubbins PER REPLICON,
    // keyed cluster_id__<replicon>. Gubbins' sliding window must never scan
    // across a contig junction (it would call spurious recombination there) and
    // snp-sites hardcodes CHROM to 1. Pair with a complete reference (curated
    // mode); the split fails loudly on a draft with > max_replicons contigs.
    split_replicons                   = false
    max_replicons                     = 4       // B. pseudomallei: 2 chromosomes (+ room for plasmids)
    // Replicons shorter than this are dropped before analysis (0 disables).
    // max_replicons is a COUNT check and cannot catch a SIZE problem: strain_12's
    // reference GCF_027856855.2 has 4 contigs -- 3.95 Mb and 3.09 Mb (the real
    // chromosomes) plus 2,595 bp and 2,533 bp -- so it passed max_replicons=4
    // cleanly, then each 2.5 kb "replicon" became its own analysis unit with its
    // own 37 snippy jobs. A 2.5 kb alignment cannot give a meaningful r/m, and a
    // unit that cannot be meaningfully partitioned before Gubbins should be
    // dropped rather than reported. Every drop is logged with its length.
    min_replicon_length               = 100000
    
    // Mash sketch parameters for large-scale analysis
    mash_sketch_size                  = 10000   // Sketch size (default: 1000, increase for large datasets)
    mash_kmer_size                    = 21      // K-mer size (default: 21)
    mash_min_copies                   = 1       // Minimum copies of each k-mer (default: 1)
    
    // ------------------------------------------------------------------
    // Clustering front end
    // ------------------------------------------------------------------
    // 'mash'    : Mash distances + single-linkage (the original path).
    // 'poppunk' : PopPUNK bgmm + refine.
    //
    // Mash single-linkage cannot partition every collection. Measured on 2,802
    // B. pseudomallei genomes: ONE connected component at threshold >= 0.007,
    // shattering to 786/1,094 singletons below it, with no value in between that
    // works -- so the Mash path emits a size-capped chop of a single component
    // (Gini 0.059, max/min 2.78), an imposed partition rather than a found one.
    // PopPUNK's refined fit on the same input gives 271 strains.
    // Mash still runs under 'poppunk': MASH_TRIANGLE's matrix is what
    // SELECT_CLUSTER_REPRESENTATIVE uses to pick each cluster's medoid.
    clustering_method                 = "mash"

    // Clusters smaller than this are dropped before analysis and listed in
    // Summaries/poppunk_excluded.tsv. PopPUNK partitions EVERYTHING -- on the
    // 2,802-genome collection 158 of its 271 strains are singletons and only 34
    // reach n >= 7. A singleton is not an analysis unit: Gubbins has nothing to
    // detect recombination against. 7 matches the smallest unit in the existing
    // analysed set, so results stay comparable to it.
    min_cluster_size                  = 7

    // PopPUNK fit parameters: Seng et al. 2024's published in-organism fit
    // (PMID 38972886), the only configuration demonstrated to feed Gubbins
    // successfully in B. pseudomallei. Their fit reported network score 0.8961
    // against a documented bar of >= 0.8.
    poppunk_min_k                     = 15
    poppunk_max_k                     = 31
    poppunk_k_step                    = 2
    poppunk_K                         = 4
    poppunk_max_a_dist                = 0.53
    // The refine pass is NOT optional in practice. Measured on this collection:
    //   bgmm alone -> 208 clusters, largest 1,723, 121 singletons
    //   + refine   -> 271 clusters, largest   913, 158 singletons
    // A 1,723-genome cluster is not an analysis unit by any definition.
    poppunk_refine                    = true

    // Choose a COMPLETE per-cluster mapping reference (completeness gate +
    // centrality ranking, borrowing the nearest complete genome when a cluster
    // has none) instead of using the medoid representative as the reference.
    // The medoid remains the cluster's backbone representative: representative
    // and reference are different objects with different requirements, and
    // conflating them previously selected a 135-contig draft as a reference.
    // Effectively REQUIRED with --split_replicons on a draft-heavy collection --
    // 90.7% of the 2,802 B. pseudomallei genomes are drafts, so the medoid is
    // usually multi-contig and the replicon split would fail on it by design.
    pick_complete_references          = false
    // Optional file of allowed borrow candidates, one name or path per line.
    // Unset means every complete genome in the input is a candidate, which
    // finds closer references but diverges from a curated shortlist: measured
    // here, the open pool beat the manual analysis's 14-reference shortlist by
    // 35-45% in mean Mash distance on 16 of 36 units. Closer is better for
    // mismapping, but a different reference gives a different r/m -- pass the
    // shortlist when results must stay comparable to existing baselines.
    reference_pool                    = null
    // Optional file of accession prefixes never to use as a mapping reference,
    // one per line, '#' comments allowed. Applies to internal picks and borrow
    // candidates alike.
    //
    // NO REFERENCE IS CURRENTLY KNOWN TO NEED THIS, and the history is worth
    // knowing before you add one. Three references were once blocklisted after
    // every cluster mapped against them failed Gubbins with "Unable to fit model
    // to data" while 23 others gave 28/28 successes. That association was real
    // and the conclusion was wrong: raxmlHPC v8 segfaults at a -n run id of 128+
    // characters, Gubbins builds that run id from the analysis unit name, and
    // the unit name comes from the reference's FASTA defline. The three simply
    // had long filenames. Settled by holding the alignment bytes IDENTICAL and
    // varying only the basename -- run id 136 fails, run id 65 succeeds -- then
    // repeated over all six previously-failing units: 12/12 succeeded against
    // the reference that had "broken" them. See --min_replicon_length's
    // neighbour gate in SPLIT_REFERENCE_REPLICONS, which now catches the real
    // cause.
    //
    // So: a reference that "fails" is a claim about the genome. Isolate the
    // variable before believing it, and record the experiment alongside the
    // entry.
    reference_blocklist               = null

    // Gubbins optimization parameters
    run_gubbins                       = true
    gubbins_iterations                = 3
    gubbins_use_hybrid                = true
    // PINNED TO RAxML 2026-08-12, and both must stay raxml. Gubbins' own default
    // is raxml, which is what the production analysis used (it passes no
    // --tree-builder at all), so this makes the pipeline reproduce production.
    //
    // MEASURED, 6 units x 2 replicons on real alignments, 12/12 completed:
    //   IQ-TREE  vs RAxML   median ratio 0.988, median |dev| 2.3%,  7/12 <1.0, sign p=0.77
    //   rapidnj  vs RAxML   median ratio 0.922, median |dev| 7.8%, 11/12 <1.0, sign p=0.0063
    //   rapidnj  vs IQ-TREE median ratio 0.938, median |dev| 6.2%, 10/12 <1.0, sign p=0.039
    // rapidnj SYSTEMATICALLY UNDERESTIMATES r/m -- a directional bias, not
    // scatter; worst case 45.5% low, and it moves a unit across the r/m band.
    // Row 3 holds the model fitter constant (under --tree-builder rapidnj Gubbins
    // delegates model fitting to IQ-TREE, since a distance method cannot fit a
    // substitution model), so the bias is the neighbour-joining TOPOLOGY, not the
    // model. Do not reintroduce a distance-based builder here.
    //
    // first_tree_builder matters just as much: with gubbins_use_hybrid = true it
    // seeds the iterations, so leaving it 'rapidnj' put the biased builder in the
    // default path even when tree_builder was 'iqtree'.
    gubbins_first_tree_builder        = "raxml"
    gubbins_tree_builder              = "raxml"
    gubbins_min_snps                  = 2

    // Feed Gubbins the IQTREE_FAST starting tree, or let Gubbins build its own.
    // The production analysis passes no --starting-tree, so reproducing it
    // requires turning this off. GUBBINS_CLUSTER already guards on
    // `[ -s "$starting_tree" ]`, so the switch just substitutes assets/NO_FILE
    // (0 bytes) for the IQTREE_FAST output -- no module change needed.
    gubbins_skip_starting_tree        = false

    // ------------------------------------------------------------------
    // Column filter on the whole-genome alignment fed to Gubbins
    // ------------------------------------------------------------------
    // Maximum fraction of taxa allowed to be non-ACGT (N, gap, ambiguity code) in a
    // column that is kept. ** THIS PARAMETER ALTERS SCIENTIFIC OUTPUT. **
    //   0.0  = the legacy all-or-nothing A/T/C/G rule (verified byte-identical output)
    //   0.10 = default. Gubbins imposes no per-column completeness rule of its own
    //          (its only missingness filter is per-taxon, --filter-percentage), and it
    //          degrades gracefully per column. Measured against a known injected 8 kb
    //          recombination block at 24 taxa: no filter recall 0.991 / 4 blocks,
    //          <=10% recall 0.921 / 4 blocks, all-ATCG recall 0.508 / 9 blocks.
    // The legacy rule is also cluster-size dependent (column survival 75.2% at 5 taxa,
    // 29.0% at 24, 6.3% at 50), so results were not comparable across cluster sizes.
    // CAVEAT: the allowance is floor(threshold * n_taxa), so 0.10 permits ZERO missing
    // taxa below 10 taxa and is therefore identical to the legacy rule for small
    // clusters. Measured column survival (100 kb): at 0.10, n=5 73.4%, n=9 57.8%,
    // n=10 88.8%, n=24 84.3%, n=50 93.1%. Use 0.25 if small clusters matter (it allows
    // one missing taxon from n=4 upward).
    //
    // CHANGED 0.10 -> 1.0 (NO COLUMN FILTER) 2026-08-12. Three independent lines of
    // evidence converge on keeping the alignment full-length:
    //
    //   1. THIS BLOCK'S OWN BENCHMARK, above: against a known injected 8 kb
    //      recombination block, NO FILTER recalls 0.991 vs 0.921 at <=10% and 0.508
    //      all-ATCG. No filtering is already the best-measured setting here.
    //   2. COORDINATE INTEGRITY. Gubbins is a SPATIAL scanning statistic: it reads
    //      recombination from the genomic SPACING of SNPs. Dropping columns
    //      renumbers every downstream position, so two mutations that flanked a
    //      high-missingness gap become closer together and local SNP density is
    //      inflated. High-missingness columns cluster in poorly-covered and
    //      repetitive regions -- exactly where recombination calls concentrate -- so
    //      the compression is biased, not uniform. This is the same principle behind
    //      splitting replicons and never feeding Gubbins a SNP-only alignment.
    //   3. MEASURED END-TO-END. s1_L1_19 chr1, identical Gubbins flags throughout:
    //        manual pipeline (no filter, 35 taxa)        r/m 2.03  [published]
    //        workflow full-length + Reference kept       r/m 2.00  <- matches
    //        workflow filtered @0.10 + Reference dropped r/m 3.23  <- +59%
    //      At 0.10 the filter dropped 148,464 of 3,100,174 columns (4.8%).
    //
    // Gubbins imposes no per-column completeness rule of its own and degrades
    // gracefully per column, so there is no correctness argument for filtering.
    // Lower it only if a specific dataset demands it, and know that doing so
    // compresses the coordinate system Gubbins depends on.
    max_column_missingness            = 1.0

    // ---- Mash / clustering front end -------------------------------------------
    // Genomes per MASH_SKETCH_BATCH task. The original scattered one task (and one
    // container start) per genome: 2000 genomes = 2000 tasks for work that
    // `mash sketch -p` parallelizes internally. 200 gives ~10 tasks at n=2000.
    mash_batch_size                   = 200

    // How oversized connected components are split when they exceed max_cluster_size.
    //   'similarity' (default) average-linkage on the component's Mash submatrix
    //   'order'      legacy: contiguous slices of a Python list, arbitrary w.r.t.
    //                phylogeny. Measured on 2000 synthetic genomes: order gave 0/40
    //                pure clusters (purity 0.1995) vs 52/52 for similarity; on the
    //                real 112-genome set it gave 0/4 pure vs 4/6. Use 'order' only to
    //                reproduce pre-existing results.
    cluster_split_method              = 'similarity'

    // Bounded consolidation pass after similarity splitting: merges adjacent parts
    // whose combined size still fits max_cluster_size and whose linkage distance is
    // within this multiple of the tighter part, so the split does not over-fragment
    // (98 -> 52 clusters at n=2000 with purity held at 1.00). Calibrated on a ~7x
    // within/between distance gap; re-check on collections with narrower structure.
    cluster_consolidate_tolerance     = 2.0
    // Hard floor on surviving columns; the process FAILS below this instead of
    // emitting a placeholder alignment.
    min_kept_columns                  = 1000

    // Gubbins per-taxon missingness filter, previously never set by the pipeline (so
    // Gubbins' own default of 25% applied silently -- measured to exclude 7 of 30
    // genomes on a real SKA-mapped set, and default vs 100 gave DIFFERENT final trees).
    // Set explicitly so exclusions are attributable. 100 disables taxon dropping.
    gubbins_filter_percentage         = 25

    // IQ-TREE parameters
    iqtree_model                      = "GTR+ASC"
    iqtree_asc_model                  = "GTR+ASC"
    iqtree_fconst                     = null

    // Starting tree for Gubbins (IQTREE_FAST). This tree is a THROWAWAY: Gubbins
    // re-estimates the tree every iteration. The old module hardcoded -m MFP, which
    // tested up to 968 DNA models and then chose plain JC.
    starting_tree_builder             = "iqtree"   // iqtree | veryfasttree | fasttree | rapidnj
    iqtree_starting_model             = "GTR+G"    // fixed cheap model, no ModelFinder

    // Branch support on the FINAL per-cluster tree (IQTREE_ASC). Previously always on
    // and unconfigurable. ** OFF BY DEFAULT ALTERS SCIENTIFIC OUTPUT ** (no UFBoot /
    // SH-aLRT values on the tree); set true for publication runs.
    iqtree_support                    = false
    iqtree_ufboot                     = 1000
    iqtree_alrt                       = 1000
    // What to do when the Gubbins-filtered alignment contains constant columns, which
    // makes +ASC ABORT with no tree written. Measured on 30 taxa x 1500 sites with 611
    // constant columns; all three give a fully resolved tree where the old code emitted
    // a 0-internal-node star tree:
    //   varsites (default) strip constant columns, KEEP +ASC, no -fconst   4.89 s
    //   fconst             strip them, DROP +ASC, pass -fconst counts      6.47 s
    //   drop_asc           alignment unchanged, DROP +ASC                  6.63 s
    // Only 'varsites' preserves the ascertainment-bias correction, so the other two
    // ALTER BRANCH LENGTHS. +ASC and -fconst are mutually exclusive; never both.
    iqtree_asc_fallback               = "varsites"   // varsites | fconst | drop_asc

    // SKA2 alignment path (alignment_method='ska')
    ska_kmer                          = 31
    
    // Integration parameters
    integrate_results                 = true    // Integrate core SNPs and graft trees across clusters
    
    // UShER parameters for incremental updates
    build_usher_mat                   = false
    existing_mat                      = null
    
    /*
    ============================================
        Recombination-aware workflow parameters
    ============================================
    */
    
    // Enable recombination-aware mode
    recombination_aware_mode          = false
    
    // Alignment method for per-cluster analysis
    // "snippy" = scattered snippy + snippy-core (accurate, needs the snippy container)
    // "ska"    = ska build per sample + ska map (fast, low-spec; retains invariant sites)
    // "parsnp" = core-genome; NOT recommended for the Gubbins path. An earlier benchmark
    //            (not re-run here, and its taxa/reference counting convention is
    //            disputed) reported Parsnp defaults silently skipping length-divergent
    //            inputs and Parsnp -c collapsing the core to a small fraction of the
    //            genome. Treat as a qualitative caution, not a verified figure.
    alignment_method                  = "snippy"  // Options: "snippy", "ska", "parsnp"

    // When true, use params.ref as the reference for every per-cluster alignment
    // (overriding the per-cluster medoid). Recommended for BP studies that want a
    // single canonical reference (e.g., K96243) across all clusters for cross-cluster
    // comparability. Default false preserves the historic medoid-per-cluster behavior.
    use_global_reference              = false

    // snippy-core always emits the reference as an extra taxon named "Reference".
    // With the DEFAULT medoid reference that taxon is, by construction, an exact
    // duplicate of a sample already in the cluster -- the medoid is drawn from the
    // cluster's own members. Measured on cluster_1 of the smoke set: samples
    // 2002721684 / 2010007509 / 2011756296, medoid 2010007509, and the alignment
    // carried all three PLUS Reference, i.e. 2010007509 twice.
    //
    // That duplicate reaches Gubbins as a zero-divergence pair, gives IQ-TREE an
    // artificial zero-length cherry (branch lengths 1e-6), inflates the taxon count
    // that feeds the ASC correction and the <3-taxa guard, and -- because
    // graft_trees.py prunes the REPRESENTATIVE tip and not "Reference" -- survives
    // into the final grafted tree once per cluster, so the published tree carries
    // several tips all named "Reference" that are DIFFERENT organisms.
    //
    //   null (default) = drop it only when it is a duplicate, i.e. when the medoid
    //                    is the reference. With use_global_reference=true the
    //                    reference is an external genome and a genuine extra taxon,
    //                    so it is kept.
    //   true / false   = force. ** false RESTORES THE LEGACY OUTPUT ** (duplicated
    //                    representative, repeated "Reference" tips).
    // ** ALTERS SCIENTIFIC OUTPUT: one fewer taxon per cluster tree by default. **
    drop_reference_taxon              = null

    // --mash_threshold accepts a number OR the string 'auto'. 'auto' sweeps
    // candidate thresholds and selects the one that analyses the most genomes
    // without producing a cluster that spans more than auto_threshold_coherence
    // of the collection's OWN largest pairwise distance. The bound is relative,
    // not an absolute Mash distance, so it transfers between collections --
    // which a fixed threshold does not: 0.003 was derived on 112 genomes and
    // drops 203 of 2795 on a wider set.
    // Measured on 2795 B. pseudomallei genomes (collection span 0.01088):
    //   0.005 -> 67 clusters,  58 dropped, within_max 0.00946 (87%)  accepted
    //   0.006 -> 61 clusters,   5 dropped, within_max 0.00946 (87%)  SELECTED
    //   0.007 -> 60 clusters,   0 dropped, within_max 0.01061 (98%)  rejected
    // 0.007 buys the last 5 genomes with a cluster spanning 98% of the whole
    // collection, which is not a clade and whose Gubbins calls are not
    // interpretable (AUDIT_REPORT.md G.3).
    auto_threshold_coherence          = 0.90
    auto_threshold_grid               = null    // comma-separated; default = 15 quantiles of the data

    // Backbone tree construction
    backbone_method                   = "parsnp"  // Options: "parsnp", "fasttree"
    backbone_fasttree_opts            = "-nt -gtr"
    backbone_container                = null      // Override container if needed
    
    // Tree grafting parameters
    enable_grafting                   = true     // Run GRAFT_TREES (graft_trees.py) at the end of the recombination-aware workflow
    graft_parent_edge_mode            = "keep"   // Branch length at the join: "keep" preserves rep edge, "zero" zeroes it
    graft_rename_conflicts            = false    // Rename cluster tip labels that collide with backbone labels
    rescale_grafted_branches          = false    // Rescale branch lengths after grafting

    /*
    ============================================
        Boilerplate options
    ============================================
    */

    tracedir                          = "${params.outdir}/pipeline_info"
    process_log_dir                   = "${params.tracedir}/process_logs"
    qc_filecheck_log_dir              = "${params.tracedir}/qc_file_checks"

    email                             = null
    hook_url                          = null
    email_on_fail                     = null

    help                              = false
    version                           = false
    validate_params                   = true
    plaintext_email                   = false
    monochrome_logs                   = false
    publish_dir_mode                  = 'copy'
    show_hidden_params                = false
    validationShowHiddenParams        = false
    validationSchemaIgnoreParams      = 'genomes,igenomes_base'

    /*
    ============================================
        Configuration options
    ============================================
    */

    custom_config_version             = 'master'
    custom_config_base                = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_description        = null
    config_profile_contact            = null
    config_profile_url                = null
    config_profile_name               = null

    /*
    ============================================
        Max resource options
    ============================================
    */

    // Defaults only, expecting to be overwritten
    max_memory                        = '128.GB'
    max_cpus                          = 16
    max_time                          = '240.h'

    /*
    ============================================
        Nextflow profile parameters
    ============================================
    */

    profile_cache_dir                 = "${projectDir}/assets/.cache"
    schema_ignore_params              = "min_tree_filesize,min_distance_matrix_filesize,min_snp_distance_filesize,min_snp_positions_filesize,max_partition_size,tree_method,curated_input,min_parsnp_output_filesize,workflows,available_workflows,validationSchemaIgnoreParams,recombination,snp_package,ref,validation-schema-ignore-params,genomes,igenomes_base,sge_process_high_cpu,sge_process_high_mem,sge_process_time,sge_options,sge_queue_size,sge_penv,existing_mat,build_usher_mat,iqtree_model,gubbins_min_snps,gubbins_use_hybrid,gubbins_iterations,gubbins_skip_starting_tree,gubbins_tree_builder,gubbins_first_tree_builder,run_gubbins,pick_complete_references,reference_pool,reference_blocklist,clustering_method,min_cluster_size,poppunk_min_k,poppunk_max_k,poppunk_k_step,poppunk_K,poppunk_max_a_dist,poppunk_refine,max_cluster_size,mash_threshold,cluster_assignments,cluster_references,split_replicons,max_replicons,min_replicon_length,workflow_mode,scalable_mode,merge_singletons,integrate_results,max_column_missingness,min_kept_columns,gubbins_filter_percentage,starting_tree_builder,iqtree_starting_model,iqtree_support,iqtree_ufboot,iqtree_alrt,iqtree_asc_fallback,ska_kmer,iqtree_asc_model,iqtree_fconst,alignment_method,cluster_split_method,cluster_consolidate_tolerance,mash_batch_size,drop_reference_taxon,auto_threshold_coherence,auto_threshold_grid"
}