/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local workstation RTX 4070 profile (22 cores, 64GB RAM, RTX 4070 GPU)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Local workstation RTX 4070'
    config_profile_description = 'Local workstation profile for 22 cores, 64GB RAM, and NVIDIA RTX 4070 GPU'
    
    // Maximum resource limits (22 cores, 58GB RAM; ~4GB headroom for the OS)
    max_cpus   = 22
    max_memory = '58.GB'
    max_time   = '240.h'
}

process {
    // Resource ceilings. Replaces nf-core's check_max(); same cap, expressed as a
    // directive so the 26.x config parser accepts it. The closure is load-bearing:
    // written as a plain list, params.max_* is read once when this file is parsed,
    // so a max_cpus/max_memory/max_time set in a later -c overlay is silently
    // ignored. check_max() read them per task. Measured: list form caps at 12 where
    // a later override says 4; closure form caps at 4, as check_max() did.
    resourceLimits = { [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ] }
    // Standard defaults optimized for local workstation with RTX 4070
    cpus              = { 2    * task.attempt }
    memory            = { 4.GB * task.attempt }
    time              = { 4.h  * task.attempt }

    errorStrategy     = { task.exitStatus in [71,104,134,137,139,140,143,255] ? 'retry' : 'finish' }
    maxRetries        = 2
    maxErrors         = '-1'

    // Process-specific resource requirements optimized for clustering workflow
    withLabel:process_single {
        cpus          = { 1 }
        memory        = { 2.GB * task.attempt }
        time          = { 2.h  * task.attempt }
    }
    withLabel:process_low {
        cpus          = { 2     * task.attempt }
        memory        = { 4.GB * task.attempt }
        time          = { 4.h   * task.attempt }
        maxForks      = 8   // Allow multiple low processes
    }
    withLabel:process_medium {
        cpus          = { 4     * task.attempt }
        memory        = { 8.GB * task.attempt }
        time          = { 8.h   * task.attempt }
        maxForks      = 4   // Allow multiple medium processes
    }
    withLabel:process_high {
        cpus          = { 8    * task.attempt }
        memory        = { 16.GB * task.attempt }
        time          = { 24.h   * task.attempt }
        maxForks      = 2   // Limit high-resource processes
    }
    withLabel:process_long {
        time          = { 96.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory        = { 24.GB * task.attempt }
        maxForks      = 2   // Limit memory-intensive processes
    }

    // Specific optimizations for the recombination-aware clustering workflow.
    //
    // MASH_SKETCH and MASH_DIST used to be tuned here; both were replaced in
    // 010ebeb by MASH_SKETCH_BATCH / MASH_PASTE / MASH_TRIANGLE, so the old
    // selectors matched nothing (Nextflow says so at startup: "no process
    // matching config selector"). The new front end needs almost nothing --
    // 2795 genomes sketch in 43 s and triangle in 41 s -- so it is left on the
    // generic labels rather than given blocks that would only misstate its cost.
    withName:CLUSTER_GENOMES {
        cpus   = 2
        memory = '4.GB'
        time   = '4.h'
    }
    withName:SELECT_CLUSTER_REPRESENTATIVE {
        cpus     = 1
        memory   = '2.GB'          // measured peak 0.07 GB
        time     = '2.h'
        maxForks = 12
    }
    // SNIPPY_ALIGN no longer exists -- a3ad4e2 replaced the monolithic per-cluster
    // process with SNIPPY_SCATTER (one task per cluster-sample) + SNIPPY_CORE_GATHER.
    // The old selector matched nothing, so on this profile the scatter silently fell
    // back to withLabel:process_medium (4 cpus x maxForks 4).
    //
    // Sizing is from MEASURED values on the 112-genome run, not budgeted ones:
    // SNIPPY_SCATTER peaked at 0.67 GB RSS and SNIPPY_CORE_GATHER at 0.54 GB, so the
    // 8-10 GB allocations above were ~12x over. Memory is not the constraint here;
    // core occupancy is.
    //
    // The scatter is 96 small independent tasks and 89% of total CPU. Per task:
    // bwa mem + sort 63%, freebayes 24%, bwa index only 6% -- so hoisting the
    // reference index out of the per-sample loop, long assumed to be the win here,
    // is worth ~5% and is NOT the lever.
    //
    // Concurrency is, but it saturates early. MEASURED on the 112-genome set, three
    // full runs, identical inputs and params, varying only maxForks:
    //
    //   forks  mean/task   sum CPU   alignment-phase wall   whole-run wall  CPU-h
    //      8       76 s     7333 s          917 s              24m53s        3.0
    //     12       91 s     8718 s          727 s              22m13s        4.5
    //     18      136 s    13027 s          724 s              21m24s        5.8
    //
    // Per-task time degrades with concurrency, so total CPU climbs faster than wall
    // time falls. Past 12 forks the alignment phase stops improving entirely: 18
    // forks buys 3 s over 12 for 50% more CPU. 12 is the knee.
    //
    // The cause is the CPU topology, not memory (peak RSS was 707 MB with 18
    // concurrent, swap untouched). `nproc` reports 22 on this Core Ultra 9 185H,
    // but that is 16 PHYSICAL cores in a hybrid arrangement -- 6 performance cores
    // with SMT plus 8 efficiency and 2 low-power-efficiency cores. Past ~12 tasks,
    // work lands on E-cores and SMT siblings that run bwa mem far slower. Do not
    // size maxForks from nproc on a hybrid CPU.
    withName:SNIPPY_SCATTER {
        cpus     = 1
        memory   = '2.GB'          // measured peak 0.67 GB
        time     = '4.h'
        maxForks = 12              // measured knee; see table above
    }
    withName:SNIPPY_CORE_GATHER {
        cpus     = 2
        memory   = '4.GB'          // measured peak 0.54 GB
        time     = '4.h'
        maxForks = 4
    }
    withName:CORE_GENOME_ALIGNMENT_PARSNP {
        cpus   = 6
        memory = '12.GB'
        time   = '8.h'
    }
    withName:KEEP_INVARIANT_ATCG {
        cpus     = 1
        memory   = '4.GB'          // measured peak 1.20 GB
        time     = '2.h'
        maxForks = 8
    }
    // Measured peak 0.87 GB and 21 s max; 12 GB was ~14x over and needlessly
    // limited how many clusters could pass through at once.
    withName:IQTREE_FAST {
        cpus     = 2
        memory   = '4.GB'
        time     = '4.h'
        maxForks = 8
    }
    // Gubbins does NOT scale with threads on this workload. Measured on the
    // 27-taxon cluster_0 alignment, rapidnj builder, identical input:
    //
    //     threads   1      2      4      8
    //     wall    164 s  144 s  140 s  144 s
    //
    // 1 -> 2 buys 12%; past 2 there is nothing. rapidnj is single-threaded and
    // the other stages do not parallelise either. The previous 10 cpus x
    // maxForks 2 therefore spent 20 cores to run TWO clusters at a time. At 61
    // clusters (2795 genomes at the auto-selected threshold) that is the second
    // biggest cost in the run, so concurrency is what matters:
    // 2 cpus x 8 forks = 16 cores and 8 clusters at once, ~4x the throughput
    // from less hardware.
    //
    // The 22.GB allocation was also 25x the measured 0.89 GB peak, and that
    // over-allocation is what FORCED maxForks=2: Nextflow's local executor packs
    // tasks by DECLARED memory, so 22 GB each means only two fit in 58 GB.
    // Right-sizing memory is what makes the extra concurrency possible.
    withName:GUBBINS_CLUSTER {
        cpus     = 2
        memory   = '6.GB'          // measured peak 0.89 GB at 27 taxa; headroom for 50
        time     = '24.h'
        maxForks = 8               // 8 x 2 = 16 cores, 8 x 6 = 48 GB
    }
    // Measured peak 0.05 GB and 25 s. It was allocated 18 GB and 10 cpus, which
    // is 360x the memory it uses and capped it at two concurrent tasks.
    withName:IQTREE_ASC {
        cpus     = 4
        memory   = '4.GB'
        time     = '12.h'
        maxForks = 5               // 5 x 4 = 20 cores, 5 x 4 = 20 GB
    }
    withName:ASC_PREFLIGHT {
        cpus     = 1
        memory   = '2.GB'          // measured peak 0.01 GB
        time     = '1.h'
        maxForks = 8
    }
    withName:COLLECT_REPRESENTATIVES {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
    // MEASURED on this machine: 12.80 GB peak, 929 s, for parsnp over 138
    // representatives on 12 threads. 20 GB stands, with headroom.
    withName:BUILD_BACKBONE_TREE {
        cpus   = 12
        memory = '20.GB'
        time   = '8.h'
    }
    withName:SUMMARIZE_CLUSTER_PHYLOGENY {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
}

executor {
    name = 'local'
    cpus = 22
    memory = '58.GB'
}