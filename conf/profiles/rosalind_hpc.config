/*
This file includes default values for Rosalind HPC parameters.
*/

params {
    sge_penv                = 'smp'
    sge_queue_size          = 100
    // sge_options moved to process.clusterOptions below. It is a closure over `task`,
    // and Nextflow 26.x rejects `task` in params scope, where it is genuinely undefined.
    sge_process_time        = 72.h
    sge_process_high_mem    = 300.GB
    sge_process_high_cpu    = 40
}

process {
    // Resource ceilings. Replaces nf-core's check_max(); same cap, expressed as a
    // directive so the 26.x config parser accepts it. The closure is load-bearing:
    // written as a plain list, params.max_* is read once when this file is parsed,
    // so a max_cpus/max_memory/max_time set in a later -c overlay is silently
    // ignored. check_max() read them per task. Measured: list form caps at 12 where
    // a later override says 4; closure form caps at 4, as check_max() did.
    resourceLimits = { [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ] }
    executor                = 'sge'
    penv                    = params.sge_penv
    queue                   = { task.time <= 4.h ? 'short.q' : task.time > 70.h ? 'long.q' : 'all.q' }
    clusterOptions          = { "-l h_vmem=${task.memory.toString().replaceAll(/[\sB]/,'')}" }
    errorStrategy           = { task.exitStatus in [71,104,134,137,139,140,143,255] ? 'retry' : 'ignore' }

    // Module specific resource adjustments
    withName: CORE_GENOME_ALIGNMENT_PARSNP {
        time                = { params.sge_process_time     * task.attempt}
        cpus                = { params.sge_process_high_cpu * task.attempt}
        memory              = { params.sge_process_high_mem * task.attempt}
    }

    withName: BUILD_PHYLOGENETIC_TREE_PARSNP {
        time                = { params.sge_process_time     * task.attempt}
        cpus                = { params.sge_process_high_cpu * task.attempt}
        memory              = { params.sge_process_high_mem * task.attempt}
    }
}

executor {
    queueSize               = params.sge_queue_size
    pollInterval            = '15 sec'
}
