/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    DGX Station A100 Updated profile (128 cores, 512GB RAM, A100 GPUs)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'DGX Station A100 Updated'
    config_profile_description = 'Updated DGX Station A100 profile for 128 cores, 512GB RAM with overhead considerations'
    
    // Maximum resource limits (leaving overhead: 120 cores, 480GB RAM)
    max_cpus   = 120
    max_memory = '480.GB'
    max_time   = '240.h'
}

process {
    // Standard defaults optimized for DGX Station A100
    cpus              = { check_max( 4    * task.attempt, 'cpus'     ) }
    memory            = { check_max( 8.GB * task.attempt, 'memory'   ) }
    time              = { check_max( 4.h  * task.attempt, 'time'     ) }

    // The `task.attempt <= 2` guard is NOT optional. Without it this closure
    // returns 'retry' for every listed exit code including 137 (OOM), so when
    // maxRetries is exhausted the strategy STILL says retry, there are none
    // left, and Nextflow terminates the whole pipeline. Measured: that killed a
    // 28-hour run. The 'finish' branch is unreachable for exactly the codes most
    // likely to exhaust retries.
    errorStrategy     = { (task.exitStatus in [71,104,134,137,139,140,143,255] && task.attempt <= 2) ? 'retry' : 'finish' }
    maxRetries        = 2
    maxErrors         = '-1'

    // Process-specific resource requirements optimized for high-performance system
    withLabel:process_single {
        cpus          = { check_max( 1                  , 'cpus'     ) }
        memory        = { check_max( 4.GB * task.attempt, 'memory'   ) }
        time          = { check_max( 2.h  * task.attempt, 'time'     ) }
    }
    withLabel:process_low {
        cpus          = { check_max( 4     * task.attempt, 'cpus'    ) }
        memory        = { check_max( 8.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 4.h   * task.attempt, 'time'    ) }
        maxForks      = 20  // Allow many concurrent low processes
    }
    withLabel:process_medium {
        cpus          = { check_max( 8     * task.attempt, 'cpus'    ) }
        memory        = { check_max( 16.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 8.h   * task.attempt, 'time'    ) }
        maxForks      = 10  // Allow multiple medium processes
    }
    withLabel:process_high {
        cpus          = { check_max( 16    * task.attempt, 'cpus'    ) }
        memory        = { check_max( 64.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 24.h   * task.attempt, 'time'   ) }
        maxForks      = 6   // Allow multiple high-resource processes
    }
    withLabel:process_long {
        time          = { check_max( 96.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_high_memory {
        memory        = { check_max( 120.GB * task.attempt, 'memory' ) }
        maxForks      = 3   // Limit very memory-intensive processes
    }

    // ---------------------------------------------------------------------
    // Recombination-aware path. This section previously tuned MASH_SKETCH,
    // MASH_DIST and SKA_BUILD -- process names that NO LONGER EXIST. 010ebeb
    // replaced the Mash front end with MASH_SKETCH_BATCH / MASH_PASTE /
    // MASH_TRIANGLE, a3ad4e2 replaced the monolithic SNIPPY_ALIGN with
    // SNIPPY_SCATTER + SNIPPY_CORE_GATHER, and the SKA build process is
    // SKA_BUILD_SAMPLE. Only 4 of the 21 processes on the active path had a
    // matching selector, so SNIPPY_SCATTER -- 89% of total CPU -- fell through
    // to withLabel:process_medium and most of a 128-core machine sat idle.
    //
    // Memory figures below are MEASURED peak RSS from the 112-genome run, not
    // budgeted. The old numbers were 12-90x over (GUBBINS_CLUSTER was allocated
    // 80 GB against a measured peak of 0.89 GB), which on a shared scheduler
    // reserves capacity nothing uses.
    // ---------------------------------------------------------------------

    // Mash front end: 2795 genomes sketch in 43 s and triangle in 41 s, so this
    // is not worth large allocations.
    withName:MASH_SKETCH_BATCH { cpus = 4;  memory = '8.GB';  time = '1.h';  maxForks = 16 }
    withName:MASH_PASTE        { cpus = 2;  memory = '8.GB';  time = '1.h' }
    withName:MASH_TRIANGLE     { cpus = 16; memory = '32.GB'; time = '2.h' }

    // consolidate_groups is O(k^2) since 334d7f9 (10 s at 2795 genomes), but the
    // dense matrix is O(n^2) float64: 62.5 MB at n=2795, ~2 GB at n=16000.
    withName:CLUSTER_GENOMES   { cpus = 6;  memory = '32.GB'; time = '2.h' }

    withName:SELECT_CLUSTER_REPRESENTATIVE { cpus = 1; memory = '4.GB';  time = '1.h'; maxForks = 32 }

    // =====================================================================
    // RETUNED 2026-08-15 from the 82-unit / 2,070-genome L1 run. Every number
    // below is MEASURED peak RSS and realtime from that run's execution_trace,
    // not budgeted. Totals for the whole run, on 20 cores:
    //
    //   process              tasks   median   max     max RSS   %cpu
    //   SNIPPY_SCATTER        4140     70 s   119 s    0.70 GB   108%
    //   GUBBINS_CLUSTER        164     74 s  1845 s    1.80 GB   261%
    //   IQTREE_FAST            164      9 s   765 s    2.50 GB   192%
    //   KEEP_INVARIANT_ATCG    164      3 s    35 s    3.60 GB   127%
    //   IQTREE_ASC             164      3 s   186 s    0.05 GB   475%
    //   SNIPPY_CORE_GATHER     164      3 s    41 s    1.30 GB    97%
    //
    // Total serial task time 90.5 h, of which SNIPPY_SCATTER is 80.5 h (89%).
    // EVERY memory figure is now attempt-scaled. Several were fixed strings, and
    // a fixed ceiling means an OOM retries at the SAME memory and fails
    // identically -- that is what ended a previous run on KEEP_INVARIANT_ATCG.
    // =====================================================================

    // THE dominant stage: 89% of all CPU time. Snippy is effectively
    // single-threaded per task -- measured %cpu is 108%, i.e. it barely exceeds
    // one core -- so throughput comes from more concurrent tasks, never from
    // more cores each. At 96 forks the 4,140 mappings take ~50 min against
    // ~7 h at the 20-core workstation's 12.
    // Memory: 96 forks x 3 GB = 288 GB, inside the 480 GB budget with room for
    // the tail of Gubbins running alongside.
    withName:SNIPPY_SCATTER     { cpus = 1; memory = { check_max( 3.GB * task.attempt, 'memory') }; time = '4.h'; maxForks = 96 }  // measured peak 0.70 GB
    withName:SNIPPY_CORE_GATHER { cpus = 2; memory = { check_max( 8.GB * task.attempt, 'memory') }; time = '4.h'; maxForks = 24 }  // measured peak 1.30 GB

    withName:SKA_BUILD_SAMPLE  { cpus = 2;  memory = { check_max( 4.GB  * task.attempt, 'memory') }; time = '1.h'; maxForks = 48 }
    withName:SKA_MAP_ALIGN     { cpus = 8;  memory = { check_max( 16.GB * task.attempt, 'memory') }; time = '2.h'; maxForks = 12 }  // measured peak 4.0 GB

    // KEEP_INVARIANT_ATCG's comment used to read "measured peak 1.20 GB" against
    // a fixed 8 GB. The real peak at n=155 is 3.60 GB, and it scales with taxa x
    // alignment length, so the old headroom was illusory at the sizes that
    // matter. Attempt-scaled from 12 GB.
    withName:KEEP_INVARIANT_ATCG { cpus = 2; memory = { check_max( 12.GB * task.attempt, 'memory') }; time = '4.h'; maxForks = 24 }  // measured peak 3.60 GB at n=155
    // IQTREE_FAST's output is DISCARDED when --gubbins_skip_starting_tree true
    // (Gubbins builds its own first tree) yet the process still runs. It is
    // cheap at these unit sizes but was the stage that OOMed twice at n=917.
    // Gate it on the skip flag rather than paying for it.
    withName:IQTREE_FAST         { cpus = 2; memory = { check_max( 8.GB  * task.attempt, 'memory') }; time = '4.h'; maxForks = 24 }  // measured peak 2.50 GB
    withName:ASC_PREFLIGHT       { cpus = 1; memory = { check_max( 2.GB  * task.attempt, 'memory') }; time = '1.h'; maxForks = 48 }
    // Trivial without branch support (0.05 GB, 186 s max). With
    // --iqtree_support true the -bb/-alrt passes dominate its cost, so the time
    // and cpus below are sized for a publication run, not the default.
    withName:IQTREE_ASC          { cpus = 4; memory = { check_max( 8.GB  * task.attempt, 'memory') }; time = '8.h'; maxForks = 24 }  // measured peak 0.05 GB (no support)

    // Gubbins: measured %cpu 261%, so 4 cores is the right allocation and more
    // is wasted. Peak RSS 1.80 GB at n=155; 12 GB is generous. 24 forks x 4 cores
    // = 96 cores, matching SNIPPY_SCATTER's footprint so the two stages can
    // overlap once groupKey lets gathers fire early.
    //
    // WHY LARGE STRAINS ARE STILL SUBDIVIDED ON A 128-CORE MACHINE, which is the
    // question this profile most often prompts. Gubbins runtime per unit is
    // ~linear in n up to about 155 (fitted t ~ 5.08 * n^1.02 s over 164 units)
    // but turns sharply superlinear beyond it: measured n=261 ~62 min, n=416
    // ~177 min, and n=917 was still inside ITERATION 1 of 5 after 10.5 h. One
    // unit is ONE task. No core count shortens it, because the work inside a
    // Gubbins iteration is not distributed across tasks -- so an unsubdivided
    // 917-genome strain is a multi-day item on the critical path whether the
    // machine has 20 cores or 128. Subdividing turns that single serial job into
    // ~43 short ones that run 24-wide and finish in minutes. Cores buy
    // throughput across units; only subdivision buys a shorter critical path.
    withName:GUBBINS_CLUSTER {
        cpus     = 4
        memory   = { check_max( 12.GB * task.attempt, 'memory') }
        time     = { check_max( 24.h  * task.attempt, 'time') }
        maxForks = 24
    }

    // parsnp over one representative per cluster; the count grows with the
    // collection (60-138 clusters at 2795 genomes depending on --mash_threshold).
    // MEASURED: 12.80 GB peak, 929 s, for 138 representatives on 12 threads.
    // Scaling is sub-linear (5.30 GB at 8 reps -> 12.80 GB at 138), so 48 GB is
    // generous well past the cluster counts this pipeline produces. It is a single
    // task near the END of a long run, so it keeps headroom rather than a tight fit.
    withName:BUILD_BACKBONE_TREE { cpus = 16; memory = '48.GB'; time = '12.h' }

    withName:COLLECT_REPRESENTATIVES     { cpus = 1; memory = '8.GB';  time = '1.h' }
    withName:SUMMARIZE_CLUSTER_PHYLOGENY { cpus = 1; memory = '8.GB';  time = '1.h' }
    withName:GRAFT_TREES                 { cpus = 2; memory = '16.GB'; time = '2.h' }
    withName:INFILE_HANDLING_UNIX        { cpus = 1; memory = { check_max( 2.GB * task.attempt, 'memory') }; time = '1.h'; maxForks = 96 }
    withName:USHER_BUILD {
        cpus   = 20
        memory = '40.GB'
        time   = '2.h'
    }
    withName:USHER_PLACE {
        cpus   = 12
        memory = '24.GB'
        time   = '1.h'
    }
    
    // Large-scale phylogenetic processes
    withName:BUILD_PHYLOGENETIC_TREE_PARSNP {
        cpus   = 24
        memory = '96.GB'
        time   = '12.h'
    }
    withName:CORE_GENOME_ALIGNMENT_PARSNP {
        cpus   = 16
        memory = '64.GB'
        time   = '8.h'
    }
    withName:BUILD_INTEGRATED_TREE {
        cpus   = 24
        memory = '96.GB'
        time   = '12.h'
    }
    
    // GPU-accelerated processes (if available in future)
    // GPU_ACCELERATED removed: no such process exists, and none could. Every
    // tree builder on this path is CPU-only -- iqtree3 contains no CUDA code,
    // and RAxML-NG, FastTree and Mash have no GPU support either. VeryFastTree's
    // `-ext CUDA` prints a "with CUDA" banner and then exits 1 on the bioconda
    // build. The A100s cannot accelerate this workflow; what makes this machine
    // fast for it is 64 cores and 512 GB, which is what the blocks above target.
    // See HANDOFF_TO_CLAUDE_CODE.md section 1 -- this is settled, do not re-add.
}

executor {
    name = 'local'
    cpus = 120
    memory = '480.GB'
}