                                          as K96243.[2m [default: false][0m 

[4m[1mAnalysis options[0m
  --snp_package                 [2m[string]  [0mSpecify what alignment tool to use to identify SNPs.[2m [default: parsnp][0m
  --tree_method                 [2m[string]  [0mTool used to infer phylogeny after masking positions due to recombination.[2m [default: fasttree][0m
  --recombination               [2m[string]  [0mTool used to classify SNPs due to recombination.[2m [default: both][0m

[4m[1mScalable workflow options[0m
  --scalable_mode               [2m[boolean] [0mEnable scalable mode using clustering-based approach for large datasets.[2m [default: false][0m
  --workflow_mode               [2m[string]  [0mWorkflow mode for scalable analysis.[2m [default: cluster][0m
  --mash_threshold              [2m[number]  [0mMash distance threshold for clustering genomes.[2m [default: 0.03][0m
  --max_cluster_size            [2m[integer] [0mMaximum number of genomes per cluster.[2m [default: 100][0m
  --run_gubbins                 [2m[boolean] [0mRun Gubbins for recombination detection in clusters.[2m [default: true][0m
  --gubbins_iterations          [2m[integer] [0mNumber of Gubbins iterations.[2m [default: 3][0m
  --gubbins_tree_builder        [2m[string]  [0mTree builder method for Gubbins.[2m [default: iqtree][0m
  --gubbins_min_snps            [2m[integer] [0mMinimum number of SNPs for Gubbins analysis.[2m [default: 2][0m
  --iqtree_model                [2m[string]  [0mSubstitution model for IQ-TREE.[2m [default: GTR+ASC][0m
  --build_usher_mat             [2m[boolean] [0mBuild UShER mutation-annotated tree for incremental updates.[2m [default: false][0m
  --existing_mat                [2m[string]  [0mPath to existing UShER MAT file for incremental placement.[2m[0m
  --merge_singletons            [2m[boolean] [0mMerge singleton clusters into their nearest non-singleton neighbor cluster, subject to mash_threshold and 
                                          max_cluster_size.[2m [default: false][0m 
  --mash_sketch_size            [2m[integer] [0mMash sketch size. Larger values stabilize the distance distribution near tight thresholds. The BP profile bumps this 
                                          to 50000.[2m [default: 10000][0m 
  --mash_kmer_size              [2m[integer] [0mK-mer size used for Mash sketching.[2m [default: 21][0m
  --mash_min_copies             [2m[integer] [0mMinimum number of copies of each k-mer required for inclusion in a Mash sketch.[2m [default: 1][0m
  --gubbins_use_hybrid          [2m[boolean] [0mWhen no starting tree is available, use the hybrid first-builder + tree-builder pathway in Gubbins.[2m [default: 
