/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    bacterial-genomics/wf-assembly-snps Nextflow configuration file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/*
================================================================================
    Load configuration files
================================================================================
*/

// Load configuration files
includeConfig "conf/params.config"
includeConfig "conf/base.config"
includeConfig "conf/workflows.config"
includeConfig "conf/modules.config"

// Set an empty test profile to pass `nf-core lint`
// This will be replaced when the profiles.conf file is loaded
// profiles { test{} }

// Load nf-core custom profiles from different Institutions
// try {
//     includeConfig "${params.custom_config_base}/nfcore_custom.config"
// } catch (Exception e) {
//     System.err.println("WARNING: Could not load nf-core/config profiles: ${params.custom_config_base}/nfcore_custom.config")
// }

// Workflow configs
// Load workflow-specific configuration files.
//
// This was a nested if/each block that walked params.workflows and built the
// include list at parse time. Nextflow 26.x's strict config parser rejects
// control flow in a config file, so the list is written out. It resolved to
// exactly these five files: params.snp_package is "parsnp", the only value
// params.available_workflows.snp_package permits, and the parsnp entry's
// `modules` list is these five modules. See conf/workflows.config.
includeConfig "modules/local/convert_samplesheet_python/params.config"
includeConfig "modules/local/infile_handling_unix/params.config"
includeConfig "modules/local/core_genome_alignment_parsnp/params.config"
includeConfig "modules/local/convert_gingr_to_fasta_harvesttools/params.config"
includeConfig "modules/local/build_phylogenetic_tree_parsnp/params.config"

// Load profiles after modules/params.conf are loaded or else test profile won't work
//includeConfig "conf/profiles.config"
profiles {
    // nf-core profiles
    debug {
        process.beforeScript   = 'echo $HOSTNAME'
    }

    conda {
        params.enable_conda    = true
        docker.enabled         = false
        singularity.enabled    = false
        shifter.enabled        = false
        conda.cacheDir         = "${params.profile_cache_dir}"
        includeConfig "conf/base.config"
    }

    docker {
        docker.enabled         = true
        singularity.enabled    = false
        shifter.enabled        = false
        // These MUST be dotted. Inside `profiles { docker { ... } }` the block is a
        // PROFILE named docker, not the docker config scope, so bare `runOptions`
        // set an inert top-level key and the container silently ran as root. Task
        // outputs then landed root-owned, and publish_dir_mode='link' failed with
        // EPERM because fs.protected_hardlinks=1 forbids hardlinking a file you
        // do not own. Verify with: nextflow config -profile docker | grep -A5 '^docker'
        //
        // NOT fixOwnership: it appends `chown -R --from=root` to every task, and
        // the BusyBox chown in alpine-based biocontainers has no --from, so each
        // task spews a usage dump into .command.err. Running as the caller in the
        // first place makes it redundant anyway.
        //
        // --shm-size=2g: Docker defaults /dev/shm to 64 MB. Gubbins' pyjar builds
        // a multiprocessing.Pool, whose semaphores and shared arrays live there,
        // and a large cluster overruns it:
        //     OSError: [Errno 28] No space left on device
        //         ... multiprocessing/synchronize.py, SemLock.__init__
        // which reads like a full disk and is not one. Hit on the 2795-genome run
        // at cluster_26 (46 taxa, 63 MB snp-sites alignment vs the 64 MB default)
        // after 21 smaller clusters had passed; 34 of the 61 clusters hold 50 taxa,
        // so nearly every remaining one would have failed too. 2g is a cap on a
        // tmpfs, not a reservation, so it costs nothing until used.
        docker.runOptions      = "-u \$(id -u):\$(id -g) --shm-size=2g"
        docker.cacheDir        = "${params.profile_cache_dir}"
        includeConfig "conf/base.config"
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        shifter.enabled        = false
        singularity.cacheDir   = "${params.profile_cache_dir}"
        includeConfig "conf/base.config"
    }

    shifter {
        shifter.enabled        = true
        docker.enabled         = false
        singularity.enabled    = false
        includeConfig "conf/base.config"
    }

    // BP (Burkholderia pseudomallei) clustering science defaults. Composable
    // with a workstation profile and a container profile. Sets recombination-
    // aware mode, larger Mash sketches, and the BP handoff §5 production values
    // for threshold / max_cluster_size / merge_singletons. Override individual
    // params at the CLI when needed. Example:
    //   -profile bp,local_workstation_rtx4070,docker
    bp {
        includeConfig "conf/profiles/bp.config"
    }

    // Aspen Univa Grid Engine profile
    aspen_hpc {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        shifter.enabled        = false
        singularity.cacheDir   = "${System.getenv('LAB_HOME')}/workflows/singularity.cache"
        includeConfig "conf/base.config"
        includeConfig "conf/profiles/aspen_hpc.config"
    }

    // Rosalind Univa Grid Engine profile
    rosalind_hpc {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        shifter.enabled        = false
        singularity.cacheDir   = "${System.getenv('LAB_HOME')}/workflows/singularity.cache"
        includeConfig "conf/base.config"
        includeConfig "conf/profiles/rosalind_hpc.config"
    }

    // Local workstation profile (12 cores, 64GB RAM)
    local_workstation {
        docker.enabled         = true
        singularity.enabled    = false
        shifter.enabled        = false
        // These MUST be dotted. Inside `profiles { docker { ... } }` the block is a
        // PROFILE named docker, not the docker config scope, so bare `runOptions`
        // set an inert top-level key and the container silently ran as root. Task
        // outputs then landed root-owned, and publish_dir_mode='link' failed with
        // EPERM because fs.protected_hardlinks=1 forbids hardlinking a file you
        // do not own. Verify with: nextflow config -profile docker | grep -A5 '^docker'
        //
        // NOT fixOwnership: it appends `chown -R --from=root` to every task, and
        // the BusyBox chown in alpine-based biocontainers has no --from, so each
        // task spews a usage dump into .command.err. Running as the caller in the
        // first place makes it redundant anyway.
        //
        // --shm-size=2g: Docker defaults /dev/shm to 64 MB. Gubbins' pyjar builds
        // a multiprocessing.Pool, whose semaphores and shared arrays live there,
        // and a large cluster overruns it:
        //     OSError: [Errno 28] No space left on device
        //         ... multiprocessing/synchronize.py, SemLock.__init__
        // which reads like a full disk and is not one. Hit on the 2795-genome run
        // at cluster_26 (46 taxa, 63 MB snp-sites alignment vs the 64 MB default)
        // after 21 smaller clusters had passed; 34 of the 61 clusters hold 50 taxa,
        // so nearly every remaining one would have failed too. 2g is a cap on a
        // tmpfs, not a reservation, so it costs nothing until used.
        docker.runOptions      = "-u \$(id -u):\$(id -g) --shm-size=2g"
        docker.cacheDir        = "${params.profile_cache_dir}"
        includeConfig "conf/base.config"
        includeConfig "conf/profiles/local_workstation.config"
    }

    // DGX Station A100 profile (128 cores, 512GB RAM)
    dgx_station {
        docker.enabled         = true
        singularity.enabled    = false
        shifter.enabled        = false
        // These MUST be dotted. Inside `profiles { docker { ... } }` the block is a
        // PROFILE named docker, not the docker config scope, so bare `runOptions`
        // set an inert top-level key and the container silently ran as root. Task
        // outputs then landed root-owned, and publish_dir_mode='link' failed with
        // EPERM because fs.protected_hardlinks=1 forbids hardlinking a file you
        // do not own. Verify with: nextflow config -profile docker | grep -A5 '^docker'
        //
        // NOT fixOwnership: it appends `chown -R --from=root` to every task, and
        // the BusyBox chown in alpine-based biocontainers has no --from, so each
        // task spews a usage dump into .command.err. Running as the caller in the
        // first place makes it redundant anyway.
        //
        // --shm-size=2g: Docker defaults /dev/shm to 64 MB. Gubbins' pyjar builds
        // a multiprocessing.Pool, whose semaphores and shared arrays live there,
        // and a large cluster overruns it:
        //     OSError: [Errno 28] No space left on device
        //         ... multiprocessing/synchronize.py, SemLock.__init__
        // which reads like a full disk and is not one. Hit on the 2795-genome run
        // at cluster_26 (46 taxa, 63 MB snp-sites alignment vs the 64 MB default)
        // after 21 smaller clusters had passed; 34 of the 61 clusters hold 50 taxa,
        // so nearly every remaining one would have failed too. 2g is a cap on a
        // tmpfs, not a reservation, so it costs nothing until used.
        docker.runOptions      = "-u \$(id -u):\$(id -g) --shm-size=2g"
        docker.cacheDir        = "${params.profile_cache_dir}"
        includeConfig "conf/base.config"
        includeConfig "conf/profiles/dgx_station.config"
    }

    // Local workstation RTX 4070 profile (22 cores, 64GB RAM, RTX 4070 GPU)
    local_workstation_rtx4070 {
        docker.enabled         = true
        singularity.enabled    = false
        shifter.enabled        = false
        // These MUST be dotted. Inside `profiles { docker { ... } }` the block is a
        // PROFILE named docker, not the docker config scope, so bare `runOptions`
        // set an inert top-level key and the container silently ran as root. Task
        // outputs then landed root-owned, and publish_dir_mode='link' failed with
        // EPERM because fs.protected_hardlinks=1 forbids hardlinking a file you
        // do not own. Verify with: nextflow config -profile docker | grep -A5 '^docker'
        //
        // NOT fixOwnership: it appends `chown -R --from=root` to every task, and
        // the BusyBox chown in alpine-based biocontainers has no --from, so each
        // task spews a usage dump into .command.err. Running as the caller in the
        // first place makes it redundant anyway.
        //
        // --shm-size=2g: Docker defaults /dev/shm to 64 MB. Gubbins' pyjar builds
        // a multiprocessing.Pool, whose semaphores and shared arrays live there,
        // and a large cluster overruns it:
        //     OSError: [Errno 28] No space left on device
        //         ... multiprocessing/synchronize.py, SemLock.__init__
        // which reads like a full disk and is not one. Hit on the 2795-genome run
        // at cluster_26 (46 taxa, 63 MB snp-sites alignment vs the 64 MB default)
        // after 21 smaller clusters had passed; 34 of the 61 clusters hold 50 taxa,
        // so nearly every remaining one would have failed too. 2g is a cap on a
        // tmpfs, not a reservation, so it costs nothing until used.
        docker.runOptions      = "-u \$(id -u):\$(id -g) --shm-size=2g"
        docker.cacheDir        = "${params.profile_cache_dir}"
        includeConfig "conf/base.config"
        includeConfig "conf/profiles/local_workstation_rtx4070.config"
    }

    // DGX Station A100 Updated profile (128 cores, 512GB RAM with overhead)
    dgx_station_a100_updated {
        docker.enabled         = true
        singularity.enabled    = false
        shifter.enabled        = false
        // These MUST be dotted. Inside `profiles { docker { ... } }` the block is a
        // PROFILE named docker, not the docker config scope, so bare `runOptions`
        // set an inert top-level key and the container silently ran as root. Task
        // outputs then landed root-owned, and publish_dir_mode='link' failed with
        // EPERM because fs.protected_hardlinks=1 forbids hardlinking a file you
        // do not own. Verify with: nextflow config -profile docker | grep -A5 '^docker'
        //
        // NOT fixOwnership: it appends `chown -R --from=root` to every task, and
        // the BusyBox chown in alpine-based biocontainers has no --from, so each
        // task spews a usage dump into .command.err. Running as the caller in the
        // first place makes it redundant anyway.
        //
        // --shm-size=2g: Docker defaults /dev/shm to 64 MB. Gubbins' pyjar builds
        // a multiprocessing.Pool, whose semaphores and shared arrays live there,
        // and a large cluster overruns it:
        //     OSError: [Errno 28] No space left on device
        //         ... multiprocessing/synchronize.py, SemLock.__init__
        // which reads like a full disk and is not one. Hit on the 2795-genome run
        // at cluster_26 (46 taxa, 63 MB snp-sites alignment vs the 64 MB default)
        // after 21 smaller clusters had passed; 34 of the 61 clusters hold 50 taxa,
        // so nearly every remaining one would have failed too. 2g is a cap on a
        // tmpfs, not a reservation, so it costs nothing until used.
        docker.runOptions      = "-u \$(id -u):\$(id -g) --shm-size=2g"
        docker.cacheDir        = "${params.profile_cache_dir}"
        includeConfig "conf/base.config"
        includeConfig "conf/profiles/dgx_station_a100_updated.config"
    }

    // Low-spec workstation profile (~8-16 cores, 32 GB RAM).
    // Targets running the 2000+ genome workload without a DGX. Composable with a
    // container profile and with `bp`; put low_spec LAST so its resource numbers win:
    //   -profile bp,low_spec,docker
    // Deliberately does NOT enable a container engine itself, so it also works with
    // -profile low_spec,singularity or with conda.
    low_spec {
        includeConfig "conf/base.config"
        includeConfig "conf/profiles/low_spec.config"
    }

    // Main test profiles
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }

    // Extra miscellaneous test profiles, often for specific use cases

}
/*
================================================================================
    Workflow information
================================================================================
*/

manifest {
    name            = 'PHemarajata/wf-assembly-snps-mod'
    author          = "Christopher A. Gulvik, PHemarajata"
    homePage        = 'https://github.com/PHemarajata/wf-assembly-snps-mod'
    description     = "Modified workflow for bacterial genome assembly SNP identification with scalable and recombination-aware analysis modes."
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.04.3'
    version         = '1.0.3-mod'
}

/*
================================================================================
    Nextflow output files
================================================================================
*/

// The timestamp is params.trace_timestamp, set in conf/params.config.

timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline_${params.trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report_${params.trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_${params.trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag_${params.trace_timestamp}.html"
}

/*
================================================================================
    Environment variables
================================================================================
*/

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

/*
================================================================================
    Workflow functions
================================================================================
*/

// Resource ceilings are applied with the `resourceLimits` process directive
// (conf/base.config and each profile), not with nf-core's check_max() helper.
// Nextflow 26.x's strict config parser rejects function definitions here.
